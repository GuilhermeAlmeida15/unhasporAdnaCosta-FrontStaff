# Para onde o Vite faz proxy de /api durante o `npm run dev`.
# Deixe em branco para usar o padrão, http://localhost:8080.
VITE_API_PROXY=http://localhost:8080

# Base das chamadas da aplicação. Em desenvolvimento deixe `/api` (o proxy
# acima resolve, e front e API ficam na mesma origem, que é o que faz o cookie
# `sessao` funcionar). Em produção, aponte para a origem real da API — e lembre
# de liberar essa origem no CORS do backend.
VITE_API_URL=/api
